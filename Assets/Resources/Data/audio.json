{
  // 音ごとの調整（どれも省略できる）。書いていない音は、音量 1・ファイル全体を使う
  //   volume   ：音量（0〜1）
  //   start    ：使う部分の始まり（秒）。BGM は、くり返すときにここへ戻る（イントロを飛ばしたいとき）
  //   end      ：使う部分の終わり（秒）。0 か省略ならファイルの終わり（Windows 版では BGM の終わりの静かな部分を自動で除く）
  //   skipIntro：BGM で true なら、1回目も start から鳴らす
  // ブラウザ版では音の中身を読めず、終わりの静かな部分を自動で見つけられないので、BGM の end は秒で書いておく
  // （Windows 版で自動で見つけた値。新しい曲を置いたら、Claude が測って書き足す）
  // 2026-10-14：届いた音の大きさを測って、Claude が仮に決めた値（聞いてみて直してよい）
  "bgm": {
    // 2026-10-14 夜：オーナーが battle を差し替え、章ごとの曲と最後のボスの曲を足した。
    // 音量は、どの曲も「ふだんの大きさ × 音量」が boss・menu と同じくらい（0.093）になるよう Claude が測って決めた
    "battle": { "volume": 0.46, "end": 116.8 },
    // はじめの 12 秒は静かなイントロ。1回目は流し、くり返すときは飛ばす
    "battle2": { "volume": 0.45, "start": 12, "end": 169.3 },
    "battle3": { "volume": 0.48, "end": 127.8 },
    "battle4": { "volume": 0.49, "end": 122.8 },
    "battle_ex": { "volume": 0.47, "end": 115.5 },
    // 4-5 で卒論審査が出たら切り替わる
    "final": { "volume": 0.5, "end": 116.5 },
    // はじめの 11 秒は静かなイントロ。ボスが出た瞬間から盛り上げたいので、1回目も飛ばす
    "boss": { "volume": 0.45, "start": 11, "end": 117.5, "skipIntro": true },
    // はじめの 21 秒は静かなイントロ。タイトルでは1回だけ流し、くり返すときは飛ばす
    "menu": { "volume": 0.5, "start": 21, "end": 118.3 }
  },
  "se": {
    "hit": { "volume": 0.5 },           // 攻撃のたびに鳴るので小さめ
    "deploy": { "volume": 0.6 },        // ほかより大きい音なので下げる
    "enemy_defeat": { "volume": 0.8 },  // 何度も鳴る
    "unit_down": { "volume": 0.85 },
    // 46 秒のファイルに何通りか入っていたので、最初の 1.2〜3.2 秒だけ使う
    "start": { "start": 1.2, "end": 3.2 }
  }
}
