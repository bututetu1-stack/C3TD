{
  // 育成とガチャ（2026-10-15 オーナー：「ソシャゲみたいにガチャとか強化要素とか…周回でアイテムドロップとか」）。
  // 部員は実在の人なのでガチャでは引かない。周回で素材と部費が落ち、素材で部員を育て（レベル・昇進）、部費で備品のガチャを引く。課金はない。
  // 数値はどれも仮。バランスは育成なしで測る（BalanceRun の間は効かない）

  // 素材。label：アイコンの丸に入れる字。rarity：1〜3（枠の色）
  "materials": [
    { "id": "paper",    "name": "コピー用紙",   "label": "紙", "rarity": 1, "color": "#9FB4CF", "description": "第1章でよく落ちる。部員のレベル上げ（Lv9 まで）に使う" },
    { "id": "energy",   "name": "エナドリ",     "label": "缶", "rarity": 1, "color": "#62D08A", "description": "第2章でよく落ちる。部員のレベル上げ（Lv10 から）に使う" },
    { "id": "suit",     "name": "リクルートスーツ", "label": "服", "rarity": 2, "color": "#5C6E96", "description": "第3章でよく落ちる。1 回目の昇進に使う" },
    { "id": "labnote",  "name": "実験ノート",   "label": "帳", "rarity": 2, "color": "#C9A15A", "description": "第4章でよく落ちる。2 回目の昇進に使う" },
    { "id": "pastexam", "name": "過去問の束",   "label": "問", "rarity": 3, "color": "#D06A8C", "description": "番外編でよく落ちる。2 回目の昇進に使う" }
  ],

  // 章ごとに落ちる素材。エンドレスは守りきった波に応じて、それまでの章の素材がまざって落ちる
  "chapterDrops": { "ch1": "paper", "ch2": "energy", "ch3": "suit", "ch4": "labnote", "ex": "pastexam" },

  // クリアしたときの部費：base ＋ 章の番号×perChapter ＋ 章の中の番号×perStage。★3 なら ×1.2、強襲なら ×1.5。負けたら lossRate 倍
  "coins": { "base": 60, "perChapter": 20, "perStage": 10, "lossRate": 0.2, "endlessPerWave": 12 },

  // 素材の数：base ＋ 章の中の番号の半分（切り捨て）＋ ★3 なら 1 ＋ 0〜1 のおまけ。強襲なら 2 倍。負けたら落ちない
  "materialDrop": { "base": 2 },

  // 部員のレベル（Lv1〜20）。1 レベルごとに体力・攻撃力・防御 +perLevel%。昇進していないと Lv10 まで
  "growth": {
    "maxLevel": 20,
    "perLevel": 1.5,
    "levels": [
      { "from": 1,  "to": 9,  "coinPerLevel": 10, "item": "paper",  "count": 2 },
      { "from": 10, "to": 19, "coinPerLevel": 10, "item": "energy", "count": 2 }
    ],
    // 昇進（アークナイツの昇進）。at：その Lv になったら昇進できる
    "promotions": [
      { "at": 10, "coin": 300, "items": [ { "id": "suit", "count": 4 } ],
        "initialSp": 5, "description": "Lv20 まで上げられる。必殺技の最初の SP +5" },
      { "at": 20, "coin": 800, "items": [ { "id": "labnote", "count": 4 }, { "id": "pastexam", "count": 2 } ],
        "spCostPercent": -15, "atkPercent": 5, "description": "必殺技の SP -15%・攻撃力 +5%" }
    ]
  },

  // 備品（ガチャで出る。部員 1 人に 1 つ付けられる）。stat：hp / atk / def（%）、interval（攻撃間隔 -%）、sp（最初の SP +）、redeploy（再配置 -%）
  // 同じ物がまた出ると「重ね」が 1 上がり、効き目が 25% ずつ上がる（4 まで。それより上は部費に換わる）
  "equipment": [
    { "id": "fusen",      "name": "付箋",                         "rarity": 1, "stat": "atk",      "value": 4,  "description": "大事なところに貼っておく" },
    { "id": "sharpen",    "name": "シャーペン",                   "rarity": 1, "stat": "def",      "value": 6,  "description": "芯は 0.5" },
    { "id": "bottle",     "name": "水筒",                         "rarity": 1, "stat": "hp",       "value": 6,  "description": "麦茶入り" },
    { "id": "usb",        "name": "USB メモリ",                   "rarity": 1, "stat": "redeploy", "value": 6,  "description": "レポートのバックアップ" },
    { "id": "keyboard",   "name": "メカニカルキーボード",         "rarity": 2, "stat": "atk",      "value": 8,  "description": "打鍵感が良い" },
    { "id": "chair",      "name": "ゲーミングチェア",             "rarity": 2, "stat": "hp",       "value": 12, "description": "長時間の作業でも疲れない" },
    { "id": "headphone",  "name": "ノイズキャンセリングヘッドホン", "rarity": 2, "stat": "sp",       "value": 4,  "description": "集中できる" },
    { "id": "battery",    "name": "モバイルバッテリー",           "rarity": 2, "stat": "interval", "value": 6,  "description": "充電切れの心配がない" },
    { "id": "senpainote", "name": "先輩のノート",                 "rarity": 3, "stat": "sp",       "value": 8,  "description": "要点がまとまっている" },
    { "id": "legendexam", "name": "伝説の過去問",                 "rarity": 3, "stat": "atk",      "value": 14, "description": "なぜか毎年当たる" },
    { "id": "hanko",      "name": "部長の判子",                   "rarity": 3, "stat": "def",      "value": 18, "description": "これがあれば通る" },
    { "id": "kotatsu",    "name": "部室のコタツ",                 "rarity": 3, "stat": "hp",       "value": 20, "description": "一度入ると出られない" }
  ],

  // 部室ガチャ。rates：★1〜★3 の出る割合（%）。10 回なら最後の 1 回は★2 以上。duplicateCoins：重ねきった物がまた出たときの部費
  "gacha": { "cost": 100, "cost10": 900, "rates": [64, 30, 6], "duplicateCoins": [20, 50, 150] }
}
