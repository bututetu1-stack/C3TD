{
  // オーナー（部員）。2026-10-14 夜、オーナーの希望で作り直した：
  //   艦娘の召喚はやめて、艦これは匂わせる程度に（必殺技の言葉「我、夜戦に突入す！」）。職業は狙撃→前衛、強めの「環境キャラ」に
  //   特徴：艦これが好き・夜ふかしが好き・だいたい寝不足（必殺技が終わると寝落ちする）
  "id": "butsuri_tetsujin",
  "name": "物理鉄人",
  "class": "Guard",
  "cost": 15,
  "redeployTime": 60,
  // 前衛だが飛ぶ敵も斬れる（環境キャラなので。必殺技で射程が伸びると届きやすい）
  "antiAir": true,
  "stats": { "hp": 2600, "atk": 620, "def": 260, "attackInterval": 1.05, "block": 2, "range": 1 },
  "trait": {
    "name": "夜戦主義",
    "description": "夜ふかしするほど調子が出る。ステージの経過時間20秒ごとに攻撃力+10%（5段まで）。前衛だが飛ぶ敵も攻撃できる",
    "trigger": "ElapsedTime",
    "params": { "interval": 20 },
    "effects": [ { "type": "StatModifier", "stat": "atk", "percentPerStack": 10, "maxStacks": 5, "target": "Self" } ]
  },
  "ultimate": {
    "name": "夜戦突入",
    "description": "15秒間、攻撃力+60%・射程+1.5マス・攻撃が2回当たる。発動した瞬間、射程内の敵すべてに攻撃力の200%。終わると寝不足で寝落ちして3秒動けない",
    "spCost": 28,
    "initialSp": 10,
    "line": "我、夜戦に突入す！",
    "endLine": "……むにゃ。もう朝……？",
    "spCharge": "PerSecond",
    "duration": 15,
    "effects": [
      // 先に射程を伸ばしてから、伸びた射程の中の敵に一撃
      { "type": "StatModifier", "stat": "range", "value": 1.5, "target": "Self" },
      { "type": "StatModifier", "stat": "atk", "percent": 60, "target": "Self" },
      { "type": "MultiHit", "hits": 2 },
      { "type": "Damage", "multiplier": 2.0, "target": "EnemiesInRange" }
    ],
    "onEnd": [
      { "type": "Stun", "duration": 3, "target": "Self" }
    ]
  }
}
