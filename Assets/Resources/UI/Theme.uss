/* C3TD の UI の見た目。クラス名は UI/*.cs で付けている。フォントはコード（GameFonts）で付ける */

.c3-root {
    color: rgb(238, 241, 246);
}

.c3-text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.full {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.stretch-image {
    -unity-background-scale-mode: stretch-to-fill;
}

.dim {
    background-color: rgba(3, 5, 10, 0.62);
}

.center-column {
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
}

.top-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 180px;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 240px;
}

/* ---------- 上のバー ---------- */
.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 96px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: 12px;
    padding-right: 22px;
}

.op-plate {
    height: 80px;
    padding-left: 34px;
    padding-right: 54px;
    justify-content: center;
}

.op-caption {
    font-size: 18px;
    letter-spacing: 7px;
    color: rgb(244, 182, 63);
    margin-bottom: -6px;
}

.op-row {
    flex-direction: row;
    align-items: center;
}

.op-code {
    font-size: 44px;
    color: rgb(255, 255, 255);
}

.op-sep {
    width: 3px;
    height: 34px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(244, 182, 63, 0.7);
    rotate: 20deg;
}

.op-name {
    font-size: 32px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

.top-spacer {
    flex-grow: 1;
}

.stat {
    height: 68px;
    margin-left: 12px;
    padding-left: 16px;
    padding-right: 22px;
    flex-direction: row;
    align-items: center;
}

.stat-icon {
    margin-right: 14px;
}

.stat-text {
    justify-content: center;
}

.stat-caption {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(142, 152, 172);
    margin-bottom: -6px;
}

.stat-value-row {
    flex-direction: row;
    align-items: flex-end;
}

.stat-value {
    font-size: 36px;
    color: rgb(255, 255, 255);
}

.stat-sub {
    font-size: 22px;
    color: rgb(142, 152, 172);
    margin-left: 3px;
    margin-bottom: 6px;
}

.life-value {
    color: rgb(255, 98, 108);
}

/* ---------- ボタン ---------- */
.c3-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.c3-button-text {
    font-size: 21px;
    margin-left: 6px;
}

.hud-button {
    width: 68px;
    height: 68px;
    margin-left: 12px;
}

.hud-button--speed {
    width: 96px;
}

/* 次の敵（NEXT）：敵のアイコン・数・あと何秒と「呼ぶ」 */
.next-plate {
    padding-right: 10px;
}

.next-icon {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    border-width: 2px;
    margin-left: 12px;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.next-icon-label {
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.next-count {
    font-size: 26px;
    color: rgb(238, 241, 246);
    margin-left: 6px;
    margin-right: 6px;
}

.call-button {
    height: 50px;
    padding-left: 12px;
    padding-right: 14px;
    margin-left: 6px;
}

.call-button .c3-button-text {
    font-size: 19px;
    margin-left: 6px;
}

/* 初めて出る敵の知らせ（画面の上のまん中） */
.new-enemy-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 104px;
    align-items: center;
}

.new-enemy {
    flex-direction: row;
    align-items: center;
    max-width: 980px;
    padding: 12px 26px 14px 24px;
}

.new-enemy-icon {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    border-width: 2px;
    border-color: rgb(239, 74, 85);
    margin-right: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.new-enemy-icon-label {
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.new-enemy-text {
    flex-shrink: 1;
}

.new-enemy-head {
    flex-direction: row;
    align-items: flex-end;
}

.new-enemy-caption {
    font-size: 19px;
    letter-spacing: 5px;
    color: rgb(239, 74, 85);
    margin-right: 14px;
    margin-bottom: 4px;
}

.new-enemy-name {
    font-size: 32px;
    color: rgb(255, 255, 255);
}

.new-enemy-traits {
    font-size: 19px;
    color: rgb(214, 219, 232);
    white-space: normal;
    -unity-paragraph-spacing: 3px;
}

/* ---------- 作戦開始 ---------- */
.intro-layer {
    justify-content: center;
    padding-bottom: 120px;
}

.intro-band {
    height: 250px;
    justify-content: center;
    padding-left: 220px;
}

.intro-content {
    align-items: flex-start;
}

.intro-caption {
    font-size: 26px;
    letter-spacing: 14px;
    color: rgb(244, 182, 63);
}

.intro-name {
    font-size: 88px;
    color: rgb(255, 255, 255);
    margin-top: -4px;
    text-shadow: 0 4px 14px rgba(0, 0, 0, 0.7);
}

.intro-start-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.intro-line {
    width: 60px;
    height: 2px;
    background-color: rgba(238, 241, 246, 0.45);
}

.intro-start {
    font-size: 26px;
    letter-spacing: 10px;
    margin-left: 16px;
    margin-right: 6px;
    color: rgb(200, 206, 222);
}

/* ---------- 一時停止 ---------- */
.pause-band {
    height: 220px;
    align-items: center;
    justify-content: center;
}

.pause-title {
    font-size: 96px;
    letter-spacing: 36px;
    padding-left: 36px;
    color: rgb(244, 182, 63);
    -unity-text-align: middle-center;
}

.pause-sub {
    font-size: 27px;
    color: rgb(200, 206, 222);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* ---------- 勝敗 ---------- */
.result-band {
    height: 400px;
    align-items: center;
    justify-content: center;
}

.result-content {
    align-items: center;
}

.result-en {
    font-size: 28px;
    letter-spacing: 18px;
    padding-left: 18px;
    -unity-text-align: middle-center;
}

.result-title {
    font-size: 150px;
    color: rgb(255, 255, 255);
    margin-top: -8px;
    -unity-text-align: middle-center;
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.7);
}

.result-milestone {
    font-size: 30px;
    color: rgb(244, 182, 63);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.result-stats {
    flex-direction: row;
    margin-top: 2px;
}

.result-stat {
    flex-direction: row;
    align-items: flex-end;
    margin-left: 30px;
    margin-right: 30px;
}

.result-stat-caption {
    font-size: 19px;
    letter-spacing: 5px;
    color: rgb(142, 152, 172);
    margin-right: 12px;
    margin-bottom: 7px;
}

.result-stat-value {
    font-size: 40px;
}

.result-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 36px;
}

/* ---------- 結果：部員の活躍と MVP ---------- */
.result-team {
    align-items: center;
    margin-top: 22px;
}

.team-caption {
    font-size: 20px;
    letter-spacing: 6px;
    color: rgb(142, 152, 172);
    margin-bottom: 10px;
}

.team-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.team-chip {
    width: 196px;
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 8px;
    padding: 12px 14px 12px 14px;
}

.team-head {
    flex-direction: row;
    align-items: center;
}

.team-portrait {
    width: 48px;
    height: 48px;
    border-width: 2px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.team-initial {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.team-name {
    font-size: 19px;
    color: rgb(255, 255, 255);
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.team-line {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 8px;
}

.team-stat-caption {
    font-size: 16px;
    color: rgb(142, 152, 172);
    margin-right: 8px;
    margin-bottom: 4px;
}

.team-stat-value {
    font-size: 30px;
    color: rgb(255, 255, 255);
}

.team-sub {
    font-size: 16px;
    color: rgb(142, 152, 172);
}

.team-track {
    height: 6px;
    margin-top: 8px;
    background-color: rgba(255, 255, 255, 0.1);
}

.team-fill {
    height: 6px;
    width: 0;
}

.team-mvp {
    position: absolute;
    right: 10px;
    top: -14px;
    font-size: 22px;
    letter-spacing: 3px;
    padding: 0 10px 0 13px;
    color: rgb(20, 17, 10);
    background-color: rgb(255, 210, 122);
}

.result-button {
    width: 300px;
    height: 76px;
    margin-left: 16px;
    margin-right: 16px;
}

.result-button .c3-button-text {
    font-size: 26px;
    margin-left: 14px;
}

/* ---------- 編成バー ---------- */
.deploy-bar {
    position: absolute;
    right: 22px;
    bottom: 16px;
    flex-direction: row;
    align-items: flex-end;
}

.dp-plate {
    width: 176px;
    height: 118px;
    margin-right: 16px;
    padding-left: 24px;
    padding-right: 18px;
    justify-content: center;
}

.dp-caption {
    font-size: 18px;
    letter-spacing: 7px;
    color: rgb(244, 182, 63);
    margin-bottom: -10px;
}

.dp-value {
    font-size: 60px;
    color: rgb(255, 255, 255);
}

.dp-track {
    height: 6px;
    margin-top: -2px;
    background-color: rgba(255, 255, 255, 0.12);
}

.dp-fill {
    height: 6px;
    width: 0;
    background-color: rgb(244, 182, 63);
}

.card-row {
    flex-direction: row;
    align-items: flex-end;
}

.deploy-card {
    width: 120px;
    height: 152px;
    margin-left: 10px;
    transition-property: translate;
    transition-duration: 0.12s;
}

.deploy-card:hover {
    translate: 0 -8px;
}

.deploy-card--dragging {
    translate: 0 -16px;
}

.card-portrait {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 30px;
    -unity-background-scale-mode: scale-and-crop;
}

.card-fallback {
    align-items: center;
    justify-content: center;
}

.card-initial {
    font-size: 58px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.5);
}

.card-class {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: 3px;
    height: 26px;
    font-size: 19px;
    color: rgb(20, 17, 10);
    -unity-text-align: middle-center;
}

.card-cost {
    position: absolute;
    left: 0;
    top: 0;
    min-width: 40px;
    height: 34px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 26px;
    color: rgb(255, 255, 255);
    background-color: rgba(6, 9, 16, 0.92);
    -unity-text-align: middle-center;
}

.deploy-card--short .card-cost {
    color: rgb(255, 98, 108);
}

.deploy-card--short .card-portrait {
    opacity: 0.35;
}

.card-shade {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    background-color: rgba(4, 6, 12, 0.7);
    align-items: center;
    justify-content: center;
}

.card-timer {
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* キーボードの数字（1〜9 でカードを選べる。スマホでは出さない） */
.card-key {
    position: absolute;
    right: 3px;
    bottom: 29px;
    width: 26px;
    height: 26px;
    font-size: 17px;
    color: rgb(244, 182, 63);
    background-color: rgba(6, 9, 16, 0.85);
    -unity-text-align: middle-center;
}

.card-state {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    padding: 2px 8px 2px 8px;
    background-color: rgba(4, 6, 12, 0.85);
}

/* ---------- 選択中の部員 ---------- */
.unit-info {
    position: absolute;
    left: 20px;
    top: 112px;
    width: 480px;
    padding: 22px 26px 22px 26px;
}

.unit-head {
    flex-direction: row;
    align-items: center;
}

.unit-portrait {
    width: 92px;
    height: 92px;
    margin-right: 18px;
    border-width: 3px;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.unit-portrait-initial {
    font-size: 52px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.unit-names {
    flex-shrink: 1;
}

.unit-class {
    align-self: flex-start;
    font-size: 18px;
    padding: 1px 12px 1px 12px;
    color: rgb(20, 17, 10);
}

.unit-name {
    font-size: 40px;
    color: rgb(255, 255, 255);
    margin-top: 2px;
}

.unit-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.unit-stat {
    width: 33%;
    flex-direction: column;
    margin-bottom: 6px;
}

.unit-stat-caption {
    font-size: 16px;
    letter-spacing: 4px;
    color: rgb(142, 152, 172);
    margin-bottom: -4px;
}

.unit-stat-value {
    font-size: 26px;
    color: rgb(255, 255, 255);
}

.unit-skill {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.unit-skill-head {
    flex-direction: row;
    align-items: center;
}

.unit-skill-kind {
    font-size: 16px;
    padding: 1px 8px 1px 8px;
    margin-right: 10px;
    color: rgb(244, 182, 63);
    border-width: 1px;
    border-color: rgba(244, 182, 63, 0.6);
}

.unit-skill-name {
    font-size: 25px;
    color: rgb(255, 255, 255);
}

.unit-skill-meta {
    font-size: 17px;
    color: rgb(142, 152, 172);
    margin-top: 4px;
}

.unit-skill-desc {
    font-size: 20px;
    color: rgb(214, 219, 232);
    margin-top: 4px;
    white-space: normal;
    -unity-paragraph-spacing: 5px;
}

/* 技のひとこと（部員らしさ。効果の説明の上に薄く） */
.unit-skill-flavor {
    font-size: 17px;
    color: rgb(142, 152, 172);
    margin-top: 4px;
    white-space: normal;
}

/* 部員のひとこと紹介（名前の下） */
.unit-profile {
    font-size: 18px;
    color: rgb(178, 186, 204);
    margin-top: 12px;
    white-space: normal;
}

/* 名前の下の状態（配置中・再配置まで・DP 不足） */
.unit-status {
    font-size: 19px;
    margin-top: 2px;
}

/* 札の中身は潰さない（入りきらないときは編成画面なら流す） */
.unit-head, .unit-profile, .unit-stats, .unit-skill {
    flex-shrink: 0;
}

.info-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

/* 出撃中の選んだ部員の札は、高さを抑えるためひとことを出さない（編成画面と、カードに重ねた札で見られる） */
.unit-info .unit-profile {
    display: none;
}

/* 編成バーのカードに重ねたときの札（カードの真上に出る。能力値は1行に並べて低くする） */
.card-tip {
    position: absolute;
    width: 600px;
    padding: 18px 24px 18px 24px;
}

.card-tip .unit-stat {
    width: 16.6%;
}

.card-tip .unit-stats {
    margin-top: 10px;
}

.card-tip .unit-portrait {
    width: 76px;
    height: 76px;
}

.card-tip .unit-name {
    font-size: 34px;
}

.unit-info--compact .unit-skill {
    margin-top: 8px;
    padding-top: 6px;
}

.unit-compact-skills {
    font-size: 19px;
    color: rgb(214, 219, 232);
    margin-top: 8px;
}

.unit-info--compact .unit-portrait {
    width: 60px;
    height: 60px;
}

.unit-info--compact .unit-name {
    font-size: 28px;
}

.unit-actions {
    position: absolute;
    flex-direction: row;
}

.retreat-button {
    width: 150px;
    height: 56px;
}

.retreat-button .c3-button-text {
    font-size: 22px;
}

.target-button {
    width: 170px;
    height: 56px;
    margin-left: 10px;
}

.target-button .c3-button-text {
    font-size: 20px;
}

/* ---------- 必殺技 ---------- */
.skill-button {
    width: 168px;
    height: 56px;
    margin-right: 10px;
}

.skill-button .c3-button-text {
    font-size: 22px;
}

.unit-stat-value--up {
    color: rgb(255, 179, 107);
}

.unit-stat-value--down {
    color: rgb(255, 110, 120);
}

/* ---------- カットイン ---------- */
.cutin-layer {
    justify-content: center;
    padding-bottom: 80px;
}

.cutin-band {
    height: 250px;
    margin-left: -140px;
    margin-right: -140px;
    rotate: -4deg;
    justify-content: center;
    padding-left: 340px;
}

.cutin-text {
    align-items: flex-start;
}

.cutin-caption {
    font-size: 28px;
    letter-spacing: 12px;
    color: rgb(244, 182, 63);
}

.cutin-name {
    font-size: 96px;
    color: rgb(255, 255, 255);
    margin-top: -6px;
    text-shadow: 0 5px 16px rgba(0, 0, 0, 0.75);
}

.cutin-line {
    font-size: 30px;
    color: rgb(230, 234, 244);
    margin-top: 2px;
}

.cutin-portrait {
    position: absolute;
    right: 360px;
    top: -70px;
    width: 390px;
    height: 390px;
    border-width: 6px;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

/* 立ち絵（Art/CutIn/{id}.png）。帯からはみ出して大きく出す */
.cutin-figure {
    position: absolute;
    right: 250px;
    top: -230px;
    width: 600px;
    height: 720px;
    -unity-background-scale-mode: scale-to-fit;
}

.cutin-initial {
    font-size: 200px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* ---------- 結果の★・一時停止メニュー ---------- */
.result-stars {
    flex-direction: row;
    justify-content: center;
    margin-top: -6px;
    margin-bottom: 4px;
}

.result-star {
    margin-left: 6px;
    margin-right: 6px;
}

/* ---------- メニュー共通 ---------- */
.menu-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 11, 19);
    -unity-background-scale-mode: scale-and-crop;
}

.menu-screen {
    padding: 0 48px 36px 48px;
}

.menu-header {
    flex-direction: row;
    align-items: center;
    height: 112px;
    flex-shrink: 0;
}

.menu-back {
    width: 128px;
    height: 56px;
    margin-right: 28px;
}

.menu-titles {
    justify-content: center;
}

.menu-caption {
    font-size: 19px;
    letter-spacing: 9px;
    color: rgb(244, 182, 63);
    margin-bottom: -6px;
}

.menu-title {
    font-size: 48px;
    color: rgb(255, 255, 255);
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
}

.menu-sub {
    font-size: 25px;
    color: rgb(200, 206, 222);
}

/* ---------- タイトル ---------- */
.title-screen {
    justify-content: center;
    padding-left: 180px;
}

.title-block {
    align-items: flex-start;
}

.title-caption {
    font-size: 25px;
    letter-spacing: 14px;
    color: rgb(244, 182, 63);
}

.title-logo {
    font-size: 260px;
    letter-spacing: 24px;
    color: rgb(255, 255, 255);
    margin-top: -40px;
    margin-bottom: -50px;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
}

.title-sub {
    font-size: 54px;
    color: rgb(255, 255, 255);
    text-shadow: 0 4px 14px rgba(0, 0, 0, 0.7);
}

.title-bar {
    width: 520px;
    height: 4px;
    margin-top: 22px;
    margin-bottom: 36px;
    background-color: rgb(244, 182, 63);
}

.title-button {
    width: 320px;
    height: 84px;
}

.title-button .c3-button-text {
    font-size: 32px;
    margin-left: 14px;
}

.title-hint {
    font-size: 21px;
    color: rgb(142, 152, 172);
    margin-top: 14px;
}

/* ---------- 作戦選択 ---------- */
.select-body {
    flex-grow: 1;
    flex-direction: row;
}

.select-left {
    flex-grow: 1;
    padding-top: 30px;
    padding-right: 30px;
}

.chapter-label {
    margin-bottom: 48px;
}

.chapter-english {
    font-size: 22px;
    letter-spacing: 10px;
    color: rgb(244, 182, 63);
}

.chapter-name {
    font-size: 56px;
    color: rgb(255, 255, 255);
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
}

.node-row {
    flex-direction: row;
    align-items: flex-start;
}

.stage-node {
    width: 196px;
    height: 136px;
    padding: 14px 18px 12px 22px;
    transition-property: translate;
    transition-duration: 0.12s;
}

.stage-node:hover {
    translate: 0 -6px;
}

.stage-node--low {
    margin-top: 110px;
}

.stage-node--locked {
    opacity: 0.6;
}

.node-code {
    font-size: 40px;
    color: rgb(255, 255, 255);
    margin-bottom: -4px;
}

.node-name {
    font-size: 21px;
    color: rgb(214, 219, 232);
    white-space: normal;
}

.node-stars {
    margin-top: 6px;
}

.node-lock {
    margin-top: 8px;
}

/* 強襲（ライフ 1・敵が強い） */
.detail-hard {
    font-size: 19px;
    color: rgb(178, 186, 204);
    margin-bottom: 10px;
    padding: 6px 12px 6px 12px;
    border-width: 1px;
    border-color: rgba(239, 74, 85, 0.45);
    -unity-text-align: middle-center;
    white-space: normal;
}

.detail-hard--on {
    color: rgb(255, 255, 255);
    background-color: rgba(239, 74, 85, 0.35);
    border-color: rgb(239, 74, 85);
}

.node-hard {
    position: absolute;
    right: 8px;
    top: 6px;
    font-size: 15px;
    padding: 0 6px 0 6px;
    color: rgb(255, 255, 255);
    background-color: rgb(239, 74, 85);
}

.op-hard {
    font-size: 20px;
    margin-left: 14px;
    padding: 2px 10px 2px 10px;
    color: rgb(255, 255, 255);
    background-color: rgb(239, 74, 85);
    align-self: center;
}

/* エンドレスの最高記録（★の代わり） */
.node-best {
    margin-top: 6px;
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(255, 210, 122);
}

.node-link {
    width: 26px;
    height: 3px;
    margin-top: 120px;
    background-color: rgba(255, 255, 255, 0.12);
}

.node-link--open {
    background-color: rgba(244, 182, 63, 0.6);
}

.unlock-toggle {
    position: absolute;
    left: 0;
    bottom: 0;
    font-size: 18px;
    color: rgb(110, 120, 140);
}

.unlock-toggle:hover {
    color: rgb(200, 206, 222);
}

.select-detail {
    width: 640px;
    padding: 28px 36px 30px 36px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.detail-code {
    font-size: 56px;
    color: rgb(244, 182, 63);
}

.detail-name {
    font-size: 46px;
    color: rgb(255, 255, 255);
    margin-top: -6px;
}

.detail-desc {
    font-size: 22px;
    color: rgb(214, 219, 232);
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 14px;
}

.detail-map {
    align-items: center;
    margin-bottom: 12px;
}

.map-preview {
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
}

.map-preview-row {
    flex-direction: row;
}

.map-preview-cell {
    border-width: 1px;
    border-color: rgba(8, 11, 19, 0.9);
}

.detail-facts {
    flex-direction: row;
    margin-bottom: 10px;
}

.detail-fact {
    flex-direction: row;
    align-items: flex-end;
    margin-right: 34px;
}

.detail-fact-caption {
    font-size: 17px;
    letter-spacing: 4px;
    color: rgb(142, 152, 172);
    margin-right: 10px;
    margin-bottom: 6px;
}

.detail-fact-value {
    font-size: 34px;
    color: rgb(255, 255, 255);
}

.detail-section {
    font-size: 19px;
    color: rgb(244, 182, 63);
    margin-bottom: 6px;
}

.detail-enemies-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-bottom: 8px;
}

.detail-enemies {
    flex-direction: row;
    flex-wrap: wrap;
}

.enemy-chip {
    flex-direction: row;
    align-items: center;
    width: 50%;
    margin-bottom: 8px;
}

.enemy-icon {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    border-radius: 28px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.enemy-icon--boss {
    border-width: 2px;
    border-color: rgb(255, 201, 77);
}

.enemy-new {
    position: absolute;
    left: -6px;
    top: -6px;
    font-size: 16px;
    color: rgb(24, 18, 6);
    background-color: rgb(244, 182, 63);
    padding: 0 5px 0 5px;
    border-radius: 3px;
}

.enemy-icon-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.enemy-text {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.enemy-name {
    font-size: 21px;
    color: rgb(238, 241, 246);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.enemy-count {
    font-size: 25px;
    color: rgb(142, 152, 172);
    margin-top: -4px;
}

.detail-lock {
    font-size: 22px;
    color: rgb(255, 98, 108);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.detail-go {
    height: 76px;
}

.detail-go .c3-button-text {
    font-size: 30px;
    margin-left: 12px;
}

/* ---------- 編成 ---------- */
.squad-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

.squad-left {
    flex-grow: 1;
    min-height: 0;
    padding-top: 10px;
    padding-right: 30px;
}

.squad-help {
    font-size: 21px;
    color: rgb(142, 152, 172);
    margin-bottom: 14px;
}

.squad-roster-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.squad-roster {
    flex-direction: row;
    flex-wrap: wrap;
}

.squad-card {
    width: 168px;
    height: 216px;
    margin: 0 16px 16px 0;
    transition-property: translate;
    transition-duration: 0.12s;
}

.squad-card:hover {
    translate: 0 -6px;
}

.squad-card .card-portrait {
    bottom: 34px;
}

.squad-card .card-class {
    height: 30px;
    font-size: 21px;
}

.squad-badge {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    font-size: 24px;
    color: rgb(20, 17, 10);
    background-color: rgb(244, 182, 63);
    -unity-text-align: middle-center;
}

.squad-detail {
    width: 620px;
    padding: 24px 30px 26px 30px;
}

.squad-footer {
    flex-direction: row;
    align-items: center;
    height: 112px;
    flex-shrink: 0;
    padding-top: 14px;
}

.squad-footer-caption {
    font-size: 19px;
    letter-spacing: 8px;
    color: rgb(244, 182, 63);
    margin-right: 18px;
}

.squad-slots {
    flex-direction: row;
}

.squad-slot {
    width: 78px;
    height: 78px;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.squad-slot--on {
    border-color: rgb(244, 182, 63);
}

.squad-slot-initial {
    font-size: 36px;
    color: rgb(255, 255, 255);
}

.squad-count {
    font-size: 34px;
    color: rgb(255, 255, 255);
    margin-left: 14px;
}

.squad-go {
    width: 300px;
    height: 84px;
}

.squad-go .c3-button-text {
    font-size: 34px;
    margin-left: 14px;
}

/* ---------- ボスの体力 ---------- */
.boss-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 104px;
    align-items: center;
}

.boss-plate {
    width: 640px;
    padding: 8px 22px 14px 26px;
}

.boss-head {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 6px;
}

.boss-caption {
    font-size: 21px;
    letter-spacing: 6px;
    color: rgb(239, 74, 85);
    margin-right: 12px;
    margin-bottom: 4px;
}

.boss-name {
    font-size: 30px;
    color: rgb(255, 255, 255);
}

.boss-hp {
    font-size: 23px;
    color: rgb(200, 206, 222);
    margin-bottom: 4px;
}

.boss-track {
    height: 12px;
    background-color: rgba(255, 255, 255, 0.08);
}

.boss-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(239, 74, 85);
}

/* ---------- 操作のヒント ---------- */
.hint-plate {
    position: absolute;
    left: 40px;
    right: 40px; /* 編成バーの左に合わせてコード（HudUI）で書き換える */
    bottom: 40px;
    max-width: 960px;
    padding: 12px 26px 16px 30px;
}

.hint-caption {
    font-size: 19px;
    letter-spacing: 6px;
    color: rgb(244, 182, 63);
    margin-bottom: 2px;
}

.hint-text {
    font-size: 26px;
    color: rgb(238, 241, 246);
    white-space: normal;
}

/* ---------- 敵の情報 ---------- */
.enemy-portrait {
    -unity-background-scale-mode: scale-to-fit;
}

.enemy-state {
    font-size: 22px;
    color: rgb(244, 182, 63);
    margin-top: 12px;
}

.unit-info--right {
    left: auto;
    right: 20px;
}

/* 敵の特別な性質（飛行・遠距離・起き上がる・まわりを強くする・手下を呼ぶ） */
.enemy-traits {
    font-size: 20px;
    color: rgb(214, 219, 232);
    margin-top: 10px;
    white-space: normal;
    -unity-paragraph-spacing: 5px;
}

/* ---------- 作戦選択の章のタブ ---------- */
.chapter-tabs {
    flex-direction: row;
    margin-bottom: 22px;
}

.chapter-tab {
    font-size: 20px;
    padding: 6px 20px 6px 20px;
    margin-right: 10px;
    color: rgb(190, 198, 214);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(10, 14, 24, 0.7);
}

.chapter-tab:hover {
    border-color: rgb(244, 182, 63);
}

.chapter-tab--on {
    color: rgb(20, 17, 10);
    background-color: rgb(244, 182, 63);
    border-color: rgb(244, 182, 63);
}

.chapter-tab--locked {
    opacity: 0.55;
}

/* 作戦選択の「出てくる敵」が多いとき（7種類以上）は3列で小さく */
.detail-enemies--many .enemy-chip {
    width: 33.3%;
    margin-bottom: 4px;
}

.detail-enemies--many .enemy-icon {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    margin-right: 8px;
}

.detail-enemies--many .enemy-icon-label {
    font-size: 17px;
}

.detail-enemies--many .enemy-name {
    font-size: 17px;
}

.detail-enemies--many .enemy-count {
    font-size: 20px;
}

/* 敵に DP の回復を減らされているあいだ */
.dp-value--drained {
    color: rgb(255, 120, 130);
}

/* ---------- 敵図鑑 ---------- */
.book-groups {
    flex-grow: 1;
    flex-shrink: 1;
}

.book-chip .enemy-icon,
.book-chip {
    flex-shrink: 0;
}

.book-group {
    margin-bottom: 14px;
}

.book-group-name {
    font-size: 22px;
    color: rgb(244, 182, 63);
    margin-bottom: 6px;
}

.book-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.book-chip {
    width: 140px;
    align-items: center;
    margin-right: 10px;
    margin-bottom: 8px;
    padding: 8px 4px 8px 4px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(10, 14, 24, 0.65);
}

.book-chip:hover {
    border-color: rgba(244, 182, 63, 0.6);
}

.book-chip--on {
    border-color: rgb(244, 182, 63);
    background-color: rgba(60, 45, 15, 0.85);
}

.book-chip .enemy-icon {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    margin-right: 0;
}

.book-chip .enemy-icon-label {
    font-size: 26px;
}

.book-name {
    font-size: 18px;
    color: rgb(238, 241, 246);
    margin-top: 6px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.book-name--long {
    font-size: 16px;
}

.book-first {
    font-size: 20px;
    color: rgb(142, 152, 172);
    margin-top: 14px;
}

.title-button.title-button--sub {
    width: 240px;
    height: 62px;
    margin-top: 14px;
}

.title-button--sub .c3-button-text {
    font-size: 26px;
}

/* タイトルの下の段（敵図鑑・遊び方・設定） */
.title-subrow {
    flex-direction: row;
}

.title-subrow .title-button--sub {
    width: 200px;
    margin-right: 14px;
}

/* ---------- 設定（音量） ---------- */
.settings-layer {
    background-color: rgba(3, 5, 10, 0.8);
    justify-content: center;
    align-items: center;
}

.settings-panel {
    width: 860px;
    padding: 28px 40px 30px 40px;
}

.settings-title {
    font-size: 44px;
    color: rgb(255, 255, 255);
    margin-bottom: 18px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.settings-caption {
    width: 130px;
    font-size: 24px;
    color: rgb(238, 241, 246);
}

.settings-step {
    width: 56px;
    height: 52px;
}

.settings-step .c3-button-text {
    font-size: 26px;
}

.settings-bar {
    flex-direction: row;
    margin-left: 10px;
    margin-right: 10px;
}

.vol-cell {
    width: 38px;
    height: 40px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.vol-cell--on {
    background-color: rgb(244, 182, 63);
    border-color: rgb(255, 210, 122);
}

.settings-value {
    width: 90px;
    margin-left: 14px;
    font-size: 28px;
    color: rgb(255, 255, 255);
}

.settings-keys {
    font-size: 18px;
    color: rgb(142, 152, 172);
    margin-top: 6px;
    margin-bottom: 18px;
    white-space: normal;
}

.settings-close {
    width: 240px;
    height: 62px;
    align-self: flex-end;
}

.settings-close .c3-button-text {
    font-size: 24px;
    margin-left: 10px;
}

.pause-settings {
    width: 260px;
    height: 56px;
    margin-top: 18px;
    align-self: center;
}

.pause-settings .c3-button-text {
    font-size: 22px;
    margin-left: 10px;
}

/* ---------- 遊び方 ---------- */
.help-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.help-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-bottom: 30px;
}

.help-card {
    width: 32%;
    margin-right: 1.2%;
    margin-bottom: 16px;
    padding: 18px 22px 20px 26px;
}

.help-caption {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(244, 182, 63);
}

.help-title {
    font-size: 30px;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.help-body {
    font-size: 19px;
    color: rgb(214, 219, 232);
    white-space: normal;
    -unity-paragraph-spacing: 6px;
}

.c3-mobile .help-card {
    width: 48.5%;
}

/* ---------- スマホ（UI を大きくしたとき。UIFactory.Zoom > 1） ---------- */
/* 作戦選択の「出てくる敵」は、縦が足りないので種類が少なくても3列にする */
.c3-mobile .detail-enemies .enemy-chip {
    width: 33.3%;
    margin-bottom: 4px;
}

.c3-mobile .detail-enemies .enemy-icon {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    margin-right: 8px;
}

.c3-mobile .detail-enemies .enemy-name {
    font-size: 17px;
}

.c3-mobile .detail-enemies .enemy-count {
    font-size: 20px;
}

/* スマホでは、部員・敵の札の説明文を少し大きく（札は広さに余裕がある） */
.c3-mobile .unit-skill-desc {
    font-size: 23px;
}

.c3-mobile .unit-skill-meta {
    font-size: 19px;
}

/* スマホの結果：帯を低くして、部員の活躍とボタンが重ならないように */
.c3-mobile .result-band {
    height: 300px;
}

.c3-mobile .result-title {
    font-size: 112px;
}

.c3-mobile .result-team {
    margin-top: 8px;
}

.c3-mobile .team-caption {
    display: none;
}

.c3-mobile .team-chip {
    width: 186px;
    padding: 8px 12px 8px 12px;
}

.c3-mobile .result-buttons {
    margin-top: 14px;
}

/* スマホの出撃中は画面の高さが足りないので、部員の札のひとことは出さない */
.c3-mobile .unit-info .unit-profile {
    display: none;
}

.c3-mobile .unit-info .unit-skill-flavor {
    display: none;
}

.c3-mobile .enemy-traits {
    font-size: 23px;
}

.c3-mobile .book-first {
    font-size: 22px;
}
