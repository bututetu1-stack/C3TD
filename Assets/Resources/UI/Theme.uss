/* C3TD の UI の見た目。クラス名は UI/*.cs で付けている。フォントはコード（GameFonts）で付ける */

.c3-root {
    color: rgb(238, 241, 246);
}

.c3-text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.full {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.stretch-image {
    -unity-background-scale-mode: stretch-to-fill;
}

.dim {
    background-color: rgba(3, 5, 10, 0.62);
}

.center-column {
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
}

.top-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 180px;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 240px;
}

/* ---------- 上のバー ---------- */
.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 96px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: 12px;
    padding-right: 22px;
}

.op-plate {
    height: 80px;
    padding-left: 34px;
    padding-right: 54px;
    justify-content: center;
}

.op-caption {
    font-size: 15px;
    letter-spacing: 7px;
    color: rgb(244, 182, 63);
    margin-bottom: -6px;
}

.op-row {
    flex-direction: row;
    align-items: center;
}

.op-code {
    font-size: 44px;
    color: rgb(255, 255, 255);
}

.op-sep {
    width: 3px;
    height: 34px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(244, 182, 63, 0.7);
    rotate: 20deg;
}

.op-name {
    font-size: 32px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

.top-spacer {
    flex-grow: 1;
}

.stat {
    height: 68px;
    margin-left: 12px;
    padding-left: 16px;
    padding-right: 22px;
    flex-direction: row;
    align-items: center;
}

.stat-icon {
    margin-right: 14px;
}

.stat-text {
    justify-content: center;
}

.stat-caption {
    font-size: 13px;
    letter-spacing: 5px;
    color: rgb(142, 152, 172);
    margin-bottom: -6px;
}

.stat-value-row {
    flex-direction: row;
    align-items: flex-end;
}

.stat-value {
    font-size: 36px;
    color: rgb(255, 255, 255);
}

.stat-sub {
    font-size: 20px;
    color: rgb(142, 152, 172);
    margin-left: 3px;
    margin-bottom: 6px;
}

.life-value {
    color: rgb(255, 98, 108);
}

/* ---------- ボタン ---------- */
.c3-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.c3-button-text {
    font-size: 18px;
    margin-left: 6px;
}

.hud-button {
    width: 68px;
    height: 68px;
    margin-left: 12px;
}

.hud-button--speed {
    width: 96px;
}

/* ---------- 作戦開始 ---------- */
.intro-layer {
    justify-content: center;
    padding-bottom: 120px;
}

.intro-band {
    height: 250px;
    justify-content: center;
    padding-left: 220px;
}

.intro-content {
    align-items: flex-start;
}

.intro-caption {
    font-size: 26px;
    letter-spacing: 14px;
    color: rgb(244, 182, 63);
}

.intro-name {
    font-size: 88px;
    color: rgb(255, 255, 255);
    margin-top: -4px;
    text-shadow: 0 4px 14px rgba(0, 0, 0, 0.7);
}

.intro-start-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.intro-line {
    width: 60px;
    height: 2px;
    background-color: rgba(238, 241, 246, 0.45);
}

.intro-start {
    font-size: 22px;
    letter-spacing: 10px;
    margin-left: 16px;
    margin-right: 6px;
    color: rgb(200, 206, 222);
}

/* ---------- 一時停止 ---------- */
.pause-band {
    height: 220px;
    align-items: center;
    justify-content: center;
}

.pause-title {
    font-size: 96px;
    letter-spacing: 36px;
    padding-left: 36px;
    color: rgb(244, 182, 63);
    -unity-text-align: middle-center;
}

.pause-sub {
    font-size: 24px;
    color: rgb(200, 206, 222);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* ---------- 勝敗 ---------- */
.result-band {
    height: 400px;
    align-items: center;
    justify-content: center;
}

.result-content {
    align-items: center;
}

.result-en {
    font-size: 28px;
    letter-spacing: 18px;
    padding-left: 18px;
    -unity-text-align: middle-center;
}

.result-title {
    font-size: 150px;
    color: rgb(255, 255, 255);
    margin-top: -8px;
    -unity-text-align: middle-center;
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.7);
}

.result-stats {
    flex-direction: row;
    margin-top: 2px;
}

.result-stat {
    flex-direction: row;
    align-items: flex-end;
    margin-left: 30px;
    margin-right: 30px;
}

.result-stat-caption {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(142, 152, 172);
    margin-right: 12px;
    margin-bottom: 7px;
}

.result-stat-value {
    font-size: 40px;
}

.result-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 36px;
}

.result-button {
    width: 300px;
    height: 76px;
    margin-left: 16px;
    margin-right: 16px;
}

.result-button .c3-button-text {
    font-size: 26px;
    margin-left: 14px;
}

/* ---------- 編成バー ---------- */
.deploy-bar {
    position: absolute;
    right: 22px;
    bottom: 16px;
    flex-direction: row;
    align-items: flex-end;
}

.dp-plate {
    width: 176px;
    height: 118px;
    margin-right: 16px;
    padding-left: 24px;
    padding-right: 18px;
    justify-content: center;
}

.dp-caption {
    font-size: 15px;
    letter-spacing: 7px;
    color: rgb(244, 182, 63);
    margin-bottom: -10px;
}

.dp-value {
    font-size: 60px;
    color: rgb(255, 255, 255);
}

.dp-track {
    height: 6px;
    margin-top: -2px;
    background-color: rgba(255, 255, 255, 0.12);
}

.dp-fill {
    height: 6px;
    width: 0;
    background-color: rgb(244, 182, 63);
}

.card-row {
    flex-direction: row;
    align-items: flex-end;
}

.deploy-card {
    width: 120px;
    height: 152px;
    margin-left: 10px;
    transition-property: translate;
    transition-duration: 0.12s;
}

.deploy-card:hover {
    translate: 0 -8px;
}

.deploy-card--dragging {
    translate: 0 -16px;
}

.card-portrait {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 30px;
    -unity-background-scale-mode: scale-and-crop;
}

.card-fallback {
    align-items: center;
    justify-content: center;
}

.card-initial {
    font-size: 58px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.5);
}

.card-class {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: 3px;
    height: 26px;
    font-size: 16px;
    color: rgb(20, 17, 10);
    -unity-text-align: middle-center;
}

.card-cost {
    position: absolute;
    left: 0;
    top: 0;
    min-width: 40px;
    height: 34px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 26px;
    color: rgb(255, 255, 255);
    background-color: rgba(6, 9, 16, 0.92);
    -unity-text-align: middle-center;
}

.deploy-card--short .card-cost {
    color: rgb(255, 98, 108);
}

.deploy-card--short .card-portrait {
    opacity: 0.35;
}

.card-shade {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    background-color: rgba(4, 6, 12, 0.7);
    align-items: center;
    justify-content: center;
}

.card-timer {
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.card-state {
    font-size: 15px;
    color: rgb(200, 206, 222);
    -unity-text-align: middle-center;
}

/* ---------- 選択中の部員 ---------- */
.unit-info {
    position: absolute;
    left: 20px;
    top: 112px;
    width: 440px;
    padding: 22px 26px 22px 26px;
}

.unit-head {
    flex-direction: row;
    align-items: center;
}

.unit-portrait {
    width: 92px;
    height: 92px;
    margin-right: 18px;
    border-width: 3px;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.unit-portrait-initial {
    font-size: 52px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.unit-names {
    flex-shrink: 1;
}

.unit-class {
    align-self: flex-start;
    font-size: 15px;
    padding: 1px 12px 1px 12px;
    color: rgb(20, 17, 10);
}

.unit-name {
    font-size: 40px;
    color: rgb(255, 255, 255);
    margin-top: 2px;
}

.unit-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.unit-stat {
    width: 33%;
    flex-direction: column;
    margin-bottom: 6px;
}

.unit-stat-caption {
    font-size: 12px;
    letter-spacing: 4px;
    color: rgb(142, 152, 172);
    margin-bottom: -4px;
}

.unit-stat-value {
    font-size: 26px;
    color: rgb(255, 255, 255);
}

.unit-skill {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.unit-skill-head {
    flex-direction: row;
    align-items: center;
}

.unit-skill-kind {
    font-size: 13px;
    padding: 1px 8px 1px 8px;
    margin-right: 10px;
    color: rgb(244, 182, 63);
    border-width: 1px;
    border-color: rgba(244, 182, 63, 0.6);
}

.unit-skill-name {
    font-size: 21px;
    color: rgb(255, 255, 255);
}

.unit-skill-meta {
    font-size: 13px;
    color: rgb(142, 152, 172);
    margin-top: 4px;
}

.unit-skill-desc {
    font-size: 16px;
    color: rgb(214, 219, 232);
    margin-top: 4px;
    white-space: normal;
}

.unit-actions {
    position: absolute;
    flex-direction: row;
}

.retreat-button {
    width: 150px;
    height: 56px;
}

.retreat-button .c3-button-text {
    font-size: 20px;
}

/* ---------- 必殺技 ---------- */
.skill-button {
    width: 168px;
    height: 56px;
    margin-right: 10px;
}

.skill-button .c3-button-text {
    font-size: 19px;
}

.unit-stat-value--up {
    color: rgb(255, 179, 107);
}

/* ---------- カットイン ---------- */
.cutin-layer {
    justify-content: center;
    padding-bottom: 80px;
}

.cutin-band {
    height: 250px;
    margin-left: -140px;
    margin-right: -140px;
    rotate: -4deg;
    justify-content: center;
    padding-left: 340px;
}

.cutin-text {
    align-items: flex-start;
}

.cutin-caption {
    font-size: 24px;
    letter-spacing: 12px;
    color: rgb(244, 182, 63);
}

.cutin-name {
    font-size: 96px;
    color: rgb(255, 255, 255);
    margin-top: -6px;
    text-shadow: 0 5px 16px rgba(0, 0, 0, 0.75);
}

.cutin-line {
    font-size: 30px;
    color: rgb(230, 234, 244);
    margin-top: 2px;
}

.cutin-portrait {
    position: absolute;
    right: 360px;
    top: -70px;
    width: 390px;
    height: 390px;
    border-width: 6px;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.cutin-initial {
    font-size: 200px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}
