/* C3TD の UI の見た目。クラス名は UI/*.cs で付けている。フォントはコード（GameFonts）で付ける */

.c3-root {
    color: rgb(238, 241, 246);
}

.c3-text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.full {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.stretch-image {
    -unity-background-scale-mode: stretch-to-fill;
}

.dim {
    background-color: rgba(3, 5, 10, 0.62);
}

.center-column {
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
}

.top-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 180px;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 240px;
}

/* ---------- 上のバー ---------- */
.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 96px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: 12px;
    padding-right: 22px;
}

.op-plate {
    height: 80px;
    padding-left: 34px;
    padding-right: 54px;
    justify-content: center;
}

.op-caption {
    font-size: 15px;
    letter-spacing: 7px;
    color: rgb(244, 182, 63);
    margin-bottom: -6px;
}

.op-row {
    flex-direction: row;
    align-items: center;
}

.op-code {
    font-size: 44px;
    color: rgb(255, 255, 255);
}

.op-sep {
    width: 3px;
    height: 34px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(244, 182, 63, 0.7);
    rotate: 20deg;
}

.op-name {
    font-size: 32px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

.top-spacer {
    flex-grow: 1;
}

.stat {
    height: 68px;
    margin-left: 12px;
    padding-left: 16px;
    padding-right: 22px;
    flex-direction: row;
    align-items: center;
}

.stat-icon {
    margin-right: 14px;
}

.stat-text {
    justify-content: center;
}

.stat-caption {
    font-size: 13px;
    letter-spacing: 5px;
    color: rgb(142, 152, 172);
    margin-bottom: -6px;
}

.stat-value-row {
    flex-direction: row;
    align-items: flex-end;
}

.stat-value {
    font-size: 36px;
    color: rgb(255, 255, 255);
}

.stat-sub {
    font-size: 20px;
    color: rgb(142, 152, 172);
    margin-left: 3px;
    margin-bottom: 6px;
}

.life-value {
    color: rgb(255, 98, 108);
}

/* ---------- ボタン ---------- */
.c3-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.c3-button-text {
    font-size: 18px;
    margin-left: 6px;
}

.hud-button {
    width: 68px;
    height: 68px;
    margin-left: 12px;
}

.hud-button--speed {
    width: 96px;
}

/* ---------- 作戦開始 ---------- */
.intro-layer {
    justify-content: center;
    padding-bottom: 120px;
}

.intro-band {
    height: 250px;
    justify-content: center;
    padding-left: 220px;
}

.intro-content {
    align-items: flex-start;
}

.intro-caption {
    font-size: 26px;
    letter-spacing: 14px;
    color: rgb(244, 182, 63);
}

.intro-name {
    font-size: 88px;
    color: rgb(255, 255, 255);
    margin-top: -4px;
    text-shadow: 0 4px 14px rgba(0, 0, 0, 0.7);
}

.intro-start-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.intro-line {
    width: 60px;
    height: 2px;
    background-color: rgba(238, 241, 246, 0.45);
}

.intro-start {
    font-size: 22px;
    letter-spacing: 10px;
    margin-left: 16px;
    margin-right: 6px;
    color: rgb(200, 206, 222);
}

/* ---------- 一時停止 ---------- */
.pause-band {
    height: 220px;
    align-items: center;
    justify-content: center;
}

.pause-title {
    font-size: 96px;
    letter-spacing: 36px;
    padding-left: 36px;
    color: rgb(244, 182, 63);
    -unity-text-align: middle-center;
}

.pause-sub {
    font-size: 24px;
    color: rgb(200, 206, 222);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* ---------- 勝敗 ---------- */
.result-band {
    height: 400px;
    align-items: center;
    justify-content: center;
}

.result-content {
    align-items: center;
}

.result-en {
    font-size: 28px;
    letter-spacing: 18px;
    padding-left: 18px;
    -unity-text-align: middle-center;
}

.result-title {
    font-size: 150px;
    color: rgb(255, 255, 255);
    margin-top: -8px;
    -unity-text-align: middle-center;
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.7);
}

.result-stats {
    flex-direction: row;
    margin-top: 2px;
}

.result-stat {
    flex-direction: row;
    align-items: flex-end;
    margin-left: 30px;
    margin-right: 30px;
}

.result-stat-caption {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(142, 152, 172);
    margin-right: 12px;
    margin-bottom: 7px;
}

.result-stat-value {
    font-size: 40px;
}

.result-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 36px;
}

.result-button {
    width: 300px;
    height: 76px;
    margin-left: 16px;
    margin-right: 16px;
}

.result-button .c3-button-text {
    font-size: 26px;
    margin-left: 14px;
}
